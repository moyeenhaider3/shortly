# backend-nest/.env.example
NODE_ENV=development
PORT=5001
DATABASE_URL=postgresql://shortly:shortly@localhost:5433/shortly_nest
# Generate with: openssl rand -hex 32  (must be at least 32 chars)
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Dev seed only, never reuse real passwords, choose at least 6 characters
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_NORMAL_EMAIL=user@example.com
SEED_NORMAL_PASSWORD=
