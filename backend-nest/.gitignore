# backend-nest/.gitignore

# Dependencies
node_modules/

# Build output (nest build -> dist/)
dist/
/src/generated

# Secrets: never commit real env files, only the template
.env*
!.env.example

# Test coverage
coverage/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# OS / editor noise
.DS_Store
.idea/
.vscode/*
!.vscode/launch.json

# Prisma (Phase 3): generated client lives in node_modules; nothing else to ignore.
# Do NOT ignore prisma/migrations/ — migrations must be committed.
