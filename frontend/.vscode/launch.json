{
  "version": "0.2.0",
  "configurations": [
    {
      // Web (Chrome) — backend expected at http://localhost:5000/api
      "name": "Flutter Web (Chrome) + peek",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-port=8080",
        "--vmservice-out-file=/tmp/flutter_peek_vmservice.txt"
      ]
    },
    {
      // Any connected device / simulator (picked from the VS Code device selector)
      "name": "Flutter (selected device) + peek",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--vmservice-out-file=/tmp/flutter_peek_vmservice.txt"]
    },
    {
      "name": "Flutter (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    }
  ]
}
